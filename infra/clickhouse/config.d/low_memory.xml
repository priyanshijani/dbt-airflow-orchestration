<!-- Laptop-sized ClickHouse (ADR-008): smaller caches, quieter logs, no heavy system log tables. -->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>16777216</uncompressed_cache_size>
    <max_concurrent_queries>32</max_concurrent_queries>

    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>

    <!-- query_log is kept: the AI Ops page reads agent query stats from it -->
    <query_thread_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
</clickhouse>
