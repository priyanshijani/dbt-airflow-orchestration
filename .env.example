# ─────────────────────────────────────────────────────────────────────────────
# dtc-growth: environment configuration
#   cp .env.example .env        then:  docker compose up -d
# Every value below works out of the box for a local demo. Keys are OPTIONAL:
# without them the stack uses committed samples and AI mock mode (ADR-006).
# ─────────────────────────────────────────────────────────────────────────────

# ── AI agents (optional) ─────────────────────────────────────────────────────
# live = call the LLM · mock = replay recorded responses (free) · off = skip agents
# Leave blank to auto-select: live if a key for LLM_PROVIDER is set, else mock.
AI_MODE=
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model IDs are pinned in Phase 5 after checking the current free-tier list (ADR-017)
LLM_MODEL_REASONING=
LLM_MODEL_LIGHT=
AI_MAX_INPUT_TOKENS=50000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_TOOL_CALLS=8

# ── Live GA4 from BigQuery (optional) ────────────────────────────────────────
# Without these, the committed sample in data/samples/ga4/ is loaded instead.
# Put the service-account JSON at ./secrets/gcp-sa.json (git-ignored).
# auto = live BigQuery when the credentials above exist, else the committed sample. sample/live forces one.
GA4_SOURCE=auto
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/opt/project/secrets/gcp-sa.json

# ── FRED macro data (optional) ───────────────────────────────────────────────
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Slack alerts (optional) ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Synthetic data ───────────────────────────────────────────────────────────
SEED=42
# Multiply synthetic volumes (ADR-007). Keep at 1 for normal use.
SCALE=1

# ── Local service credentials (demo only, change for anything shared) ───────
POSTGRES_PASSWORD=postgres_local
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_local
SHOP_DB_USER=shop_app
SHOP_DB_PASSWORD=shop_local

CLICKHOUSE_ADMIN_USER=ch_admin
CLICKHOUSE_ADMIN_PASSWORD=ch_admin_local
CLICKHOUSE_ETL_PASSWORD=etl_local
CLICKHOUSE_AGENT_PASSWORD=agent_local
CLICKHOUSE_HUB_PASSWORD=hub_local
CLICKHOUSE_AI_WRITER_PASSWORD=ai_writer_local

S3_ACCESS_KEY=dtc_landing
S3_SECRET_KEY=dtc_landing_secret
S3_BUCKET=landing

AIRFLOW_JWT_SECRET=change-me-local-demo-secret
PII_HASH_SALT=local-demo-salt
